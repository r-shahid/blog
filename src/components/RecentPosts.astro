---
const { posts } = Astro.props;
---

<div class="recent-section">
    <h2>Recent Posts</h2>
    <div class="posts">
        {posts.map((post: {
                            id: any; 
                            data: {title: string; description: string; topic: string; }; 
            }) => {
            const {title, description, topic} = post.data;
            return(
                <a href={`/posts/${post.id}`}>
                    <div class="article">
                        <img src="/img.jpg"/>
                        <h3 class="title">{title}</h3>
                         <div class="desc">{description}</div>
                        <button class="category">{topic}</button>
                    </div>
                </a>
            )
        })}
    </div>
</div>