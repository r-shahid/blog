---
const { post } = Astro.props;
const { title, description, topic, pubDate, heroImage } = post.data;
---

<article class="featured">
    <div class="info">
        <div class="title">{title}</div>
        <div class="preview">{description} <br /><a href={`/posts/${post.id}`}>Read More <span class="visually-hidden">about {title}</span></a></div>
        <button>{topic}</button>
    </div>
    <img src="/img.jpg"/>
</article>